{
  "name": "@jurgen1c/agent-memory-cli",
  "version": "0.4.0",
  "description": "Repository-local agent memory CLI based on atomic claims and generated indexes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jurgen1c/agent_memory.git"
  },
  "keywords": [
    "agent",
    "memory",
    "cli",
    "codex",
    "repository"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agent-memory": "dist/agent-memory.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@jurgen1c/agent-core": "^0.1.0",
    "@xyflow/react": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "nanoid": "^3.3.17"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.5.0",
    "happy-dom": "^20.10.6",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.62.0",
    "vite": "^7.3.6"
  },
  "files": [
    "dist/",
    "packages/schemas/*.schema.json",
    "dist/web/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:web && bun run build:library && bun run build:types && bun run build:agent-memory",
    "build:agent-memory": "bun build packages/cli/src/index.ts --target=node --packages=external --outfile=dist/agent-memory.js",
    "build:library": "bun build packages/core/src/index.ts --target=node --packages=external --outfile=dist/index.js",
    "build:types": "tsc -p tsconfig.build.json",
    "build:web": "bun run --cwd packages/web build",
    "typecheck": "bun run typecheck:packages && bun run typecheck:web",
    "typecheck:packages": "tsc --noEmit -p tsconfig.json",
    "typecheck:web": "tsc --noEmit -p packages/web/tsconfig.json",
    "audit": "bun audit --audit-level moderate",
    "ci": "bun run audit && bun test && bun run lint && bun run typecheck && bun run build",
    "lint": "eslint .",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "dev": "bun packages/cli/src/index.ts",
    "ui:mock": "scripts/run-mock-ui.sh",
    "prepack": "bun run build",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "engines": {
    "node": ">=25.9.0"
  }
}
