{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Memory Config",
  "type": "object",
  "required": ["version", "memory_root", "database_path", "claims", "graphs", "indexes", "recipes", "plans", "profiles", "waivers"],
  "properties": {
    "version": { "const": 1 },
    "memory_root": { "type": "string" },
    "database_path": { "type": "string" },
    "claims": { "type": "array", "items": { "type": "string" } },
    "graphs": { "type": "array", "items": { "type": "string" } },
    "indexes": { "type": "array", "items": { "type": "string" } },
    "recipes": { "type": "array", "items": { "type": "string" } },
    "plans": { "type": "array", "items": { "type": "string" } },
    "profiles": { "type": "array", "items": { "type": "string" } },
    "waivers": { "type": "array", "items": { "type": "string" } },
    "agent_instructions": {
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "anyOf": [
        { "required": ["path"] },
        { "required": ["paths"] }
      ],
      "additionalProperties": false
    },
    "claim_sources": {
      "type": "object",
      "required": ["allow", "deny"],
      "properties": {
        "allow": { "type": "array", "items": { "type": "string" } },
        "deny": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
