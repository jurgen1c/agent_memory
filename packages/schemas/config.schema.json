{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Memory Config",
  "type": "object",
  "required": ["version", "memory_root", "database_path", "claims", "graphs", "indexes", "recipes", "plans", "profiles", "waivers"],
  "properties": {
    "version": { "enum": [1, 2] },
    "memory_key": {
      "type": "string",
      "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|$))[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9_-])?$"
    },
    "database_scope": { "enum": ["local", "global"] },
    "memory_root": { "type": "string" },
    "database_path": { "type": "string" },
    "claims": { "type": "array", "items": { "type": "string" } },
    "graphs": { "type": "array", "items": { "type": "string" } },
    "indexes": { "type": "array", "items": { "type": "string" } },
    "recipes": { "type": "array", "items": { "type": "string" } },
    "plans": { "type": "array", "items": { "type": "string" } },
    "profiles": { "type": "array", "items": { "type": "string" } },
    "waivers": { "type": "array", "items": { "type": "string" } },
    "agent_instructions": {
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "anyOf": [
        { "required": ["path"] },
        { "required": ["paths"] }
      ],
      "additionalProperties": false
    },
    "claim_sources": {
      "type": "object",
      "required": ["allow", "deny"],
      "properties": {
        "allow": { "type": "array", "items": { "type": "string" } },
        "deny": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "version": { "const": 1 } }, "required": ["version"] },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["memory_key"] },
            { "required": ["database_scope"] }
          ]
        }
      }
    },
    {
      "if": { "properties": { "version": { "const": 2 } }, "required": ["version"] },
      "then": {
        "required": ["database_scope"],
        "if": { "properties": { "database_scope": { "const": "global" } }, "required": ["database_scope"] },
        "then": { "required": ["memory_key"] }
      }
    }
  ]
}
